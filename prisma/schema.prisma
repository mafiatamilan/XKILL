generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 5.1 — Auth & Identity
// ---------------------------------------------------------------------------

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  fullName                String
  avatarUrl               String?
  roleId                  String
  role                    Role                     @relation(fields: [roleId], references: [id])
  isActive                Boolean                  @default(true)
  emailVerifiedAt         DateTime?
  suspendedAt             DateTime?
  suspendReason           String?
  deletedAt               DateTime?
  twoFactor               TwoFactorSecret?
  sessions                Session[]
  devices                 Device[]
  oauthAccounts           OAuthAccount[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  studentProfile          StudentProfile?
  skillProfiles           SkillProfile[]
  careerGoals             CareerGoal[]
  readinessScore          ReadinessScore?
  readinessPrediction     ReadinessPrediction?
  roadmapWeeks            RoadmapWeek[]
  progressRecords         ProgressRecord[]
  studyPlans              StudyPlan[]
  notifications           Notification[]
  calendarEvents          CalendarEvent[]
  activityLogs            ActivityLog[]
  settings                UserSettings?
  facultySubjects         Subject[]                @relation("SubjectFaculty")
  attendanceRecords       AttendanceRecord[]       @relation("StudentAttendance")
  internalMarks           InternalMark[]           @relation("StudentInternalMarks")
  assignmentSubmissions   AssignmentSubmission[]   @relation("StudentSubmissions")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdAt])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  users       User[]
  permissions Permission[] @relation("RolePermissions")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  roles       Role[]   @relation("RolePermissions")
  createdAt   DateTime @default(now())

  @@index([name])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  deviceId         String?
  device           Device?   @relation(fields: [deviceId], references: [id])
  ip               String?
  userAgent        String?
  issuedAt         DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([revokedAt])
  @@index([expiresAt])
}

model Device {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String?
  platform   String?
  browser    String?
  os         String?
  pushToken  String?
  lastUsedAt DateTime  @default(now())
  sessions   Session[]
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  providerEmail     String?
  profileJson       Json?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([providerEmail])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TwoFactorSecret {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret     String
  isEnabled  Boolean   @default(false)
  verifiedAt DateTime?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// 5.2 — Student Platform
// ---------------------------------------------------------------------------

model StudentProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline               String?
  bio                    String?
  phone                  String?
  dateOfBirth            DateTime?
  gender                 String?
  githubUrl              String?
  linkedinUrl            String?
  portfolioUrl           String?
  leetcodeUrl            String?
  codeforcesUrl          String?
  resumeUrl              String?
  city                   String?
  state                  String?
  country                String?
  collegeName            String?
  department             String?
  currentSemester        Int?
  expectedGraduationYear Int?
  isProfileVisible       Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([collegeName])
  @@index([department])
  @@index([expectedGraduationYear])
}

model SkillProfile {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  category          String   @default("other")
  proficiencyLevel  String   @default("intermediate") // beginner | intermediate | advanced | expert
  yearsOfExperience Float?   @default(0)
  isPrimary         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([category])
}

model CareerGoal {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  targetRole         String?
  targetCompanies    String[]
  industries         String[]
  preferredLocations String[]
  targetCtcLakhs     Int?
  targetDate         DateTime?
  status             String    @default("active") // active | achieved | archived
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([targetRole])
}

model ReadinessScore {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  overall      Int
  components   Json
  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([overall])
  @@index([calculatedAt])
}

model ReadinessPrediction {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readinessScore  Int
  predictedLevel  String // low | medium | high
  monthsToReady   Int
  components      Json
  predictedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([predictedLevel])
  @@index([predictedAt])
}

model RoadmapWeek {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber    Int
  title         String
  focus         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tasks         DailyTask[]

  @@unique([userId, weekNumber])
  @@index([userId])
}

model DailyTask {
  id            String      @id @default(cuid())
  roadmapWeekId String
  roadmapWeek   RoadmapWeek @relation(fields: [roadmapWeekId], references: [id], onDelete: Cascade)
  day           Int
  title         String
  description   String
  taskType      String // dsa | aptitude | company | project | resume | mock
  reference     String? // generic reference, no FK to DSA Problem yet
  isCompleted   Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([roadmapWeekId])
}

model CompanyPrepTrack {
  id          String   @id @default(cuid())
  company     String   @unique
  description String
  focusAreas  String[]
  resources   Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([company])
}

model ProgressRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalTasks Int
  completed  Int
  percent    Int
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([recordedAt])
}

model DailyChallenge {
  id          String   @id @default(cuid())
  date        DateTime @unique
  title       String
  description String
  taskType    String // dsa | aptitude | company | project | mock
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model StudyPlan {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  plan       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @default("system") // system | announcement | academic | placement | job | mentor | general
  title     String
  message   String
  metadata  Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  eventType   String    @default("personal") // interview | study | exam | placement | personal | other
  startAt     DateTime
  endAt       DateTime?
  location    String?
  isAllDay    Boolean   @default(false)
  color       String?
  reminderAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, startAt])
  @@index([eventType])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // profile | skill | career_goal | calendar | readiness | notification | system
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([type])
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  weeklyDigest       Boolean  @default(true)
  language           String   @default("en")
  theme              String   @default("light") // light | dark | system
  profileVisibility  String   @default("public") // public | recruiters_only | private
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// 5.3 — College Academic Module
// ---------------------------------------------------------------------------

model Department {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  description String?
  subjects    Subject[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

model Semester {
  id        String    @id @default(cuid())
  number    Int       @unique
  name      String
  scheme    String? // e.g. "2019" old scheme, "2023" new scheme — credit weight origin
  subjects  Subject[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([number])
}

model Subject {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  description       String?
  credit            Int                @default(4)
  departmentId      String
  department        Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semesterId        String
  semester          Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  facultyId         String?
  faculty           User?              @relation("SubjectFaculty", fields: [facultyId], references: [id], onDelete: SetNull)
  materials         StudyMaterial[]
  exams             Exam[]
  assignments       Assignment[]
  attendanceRecords AttendanceRecord[]
  timetableSlots    TimetableSlot[]
  internalMarks     InternalMark[]
  questionBank      QuestionBankItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([departmentId])
  @@index([semesterId])
  @@index([facultyId])
  @@index([credit])
}

model StudyMaterial {
  id         String   @id @default(cuid())
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title      String
  type       String   @default("note") // note | slide | video | link | reference
  url        String
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([subjectId])
}

model Exam {
  id          String         @id @default(cuid())
  subjectId   String
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  examType    String         @default("internal") // internal | midterm | endterm | practical
  maxMarks    Float          @default(100)
  scheduledAt DateTime?
  marks       InternalMark[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([subjectId])
}

model Assignment {
  id          String                 @id @default(cuid())
  subjectId   String
  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  maxScore    Float?
  dueAt       DateTime?
  submissions AssignmentSubmission[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([subjectId])
}

model AssignmentSubmission {
  id            String     @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  content       String?
  attachmentUrl String?
  submittedAt   DateTime   @default(now())
  status        String     @default("submitted") // submitted | graded
  score         Float?
  feedback      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  sessionDate DateTime
  status      String   @default("present") // present | absent | late | excused
  markedBy    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([subjectId, studentId, sessionDate])
  @@index([studentId])
  @@index([subjectId])
}

model TimetableSlot {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Mon .. 6=Sun
  startTime String
  endTime   String
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([dayOfWeek])
}

model InternalMark {
  id            String   @id @default(cuid())
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examId        String?
  exam          Exam?    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       User     @relation("StudentInternalMarks", fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained Float
  maxMarks      Float
  attempt       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([subjectId, studentId, examId])
  @@index([studentId])
  @@index([subjectId])
}

model AcademicCalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  eventType   String    @default("academic") // academic | exam | holiday | event | deadline
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startAt])
  @@index([eventType])
}

model QuestionBankItem {
  id            String   @id @default(cuid())
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  question      String
  options       Json?
  correctAnswer String?
  difficulty    String   @default("medium") // easy | medium | hard
  marks         Float?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([subjectId])
  @@index([difficulty])
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
