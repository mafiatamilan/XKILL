generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 5.1 — Auth & Identity
// ---------------------------------------------------------------------------

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  fullName                String
  avatarUrl               String?
  roleId                  String
  role                    Role                     @relation(fields: [roleId], references: [id])
  isActive                Boolean                  @default(true)
  emailVerifiedAt         DateTime?
  suspendedAt             DateTime?
  suspendReason           String?
  deletedAt               DateTime?
  twoFactor               TwoFactorSecret?
  sessions                Session[]
  devices                 Device[]
  oauthAccounts           OAuthAccount[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  studentProfile          StudentProfile?
  skillProfiles           SkillProfile[]
  careerGoals             CareerGoal[]
  readinessScore          ReadinessScore?
  readinessPrediction     ReadinessPrediction?
  roadmapWeeks            RoadmapWeek[]
  progressRecords         ProgressRecord[]
  studyPlans              StudyPlan[]
  notifications           Notification[]
  calendarEvents          CalendarEvent[]
  activityLogs            ActivityLog[]
  settings                UserSettings?
  facultySubjects         Subject[]                @relation("SubjectFaculty")
  attendanceRecords       AttendanceRecord[]       @relation("StudentAttendance")
  internalMarks           InternalMark[]           @relation("StudentInternalMarks")
  assignmentSubmissions   AssignmentSubmission[]   @relation("StudentSubmissions")
  dsaSubmissions          Submission[]
  solvedProblems          SolvedProblem[]
  hintUnlocks             HintUnlock[]
  playlists               Playlist[]
  discussionPosts         Discussion[]             @relation("DiscussionAuthor")
  discussionVotes         DiscussionVote[]
  dsaProfileVisibility    DsaProfileVisibility?
  contestParticipants     ContestParticipant[]     @relation("ContestParticipants")
  contestCreated          Contest[]
  codingRating            CodingRating?            @relation("CodingRatingUser")
  ratingHistory           CodingRatingHistory[]    @relation("CodingRatingHistoryUser")
  antiCheatEvents         AntiCheatEvent[]         @relation("AntiCheatUser")
  battleWinner            Battle[]                 @relation("BattleWinner")
  battleCreator           Battle[]                 @relation("BattleCreator")
  battleParticipations    BattleParticipant[]      @relation("BattleParticipantUser")
  interviewSessions       InterviewSession[]
  careerRoadmapItems      CareerRoadmapItem[]
  learningRecommendations LearningRecommendation[]
  salaryPredictions       SalaryPrediction[]
  skillGaps               SkillGap[]
  careerChatMessages      CareerChatMessage[]
  resumes                 Resume[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdAt])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  users       User[]
  permissions Permission[] @relation("RolePermissions")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  roles       Role[]   @relation("RolePermissions")
  createdAt   DateTime @default(now())

  @@index([name])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  deviceId         String?
  device           Device?   @relation(fields: [deviceId], references: [id])
  ip               String?
  userAgent        String?
  issuedAt         DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([revokedAt])
  @@index([expiresAt])
}

model Device {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String?
  platform   String?
  browser    String?
  os         String?
  pushToken  String?
  lastUsedAt DateTime  @default(now())
  sessions   Session[]
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  providerEmail     String?
  profileJson       Json?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([providerEmail])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TwoFactorSecret {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret     String
  isEnabled  Boolean   @default(false)
  verifiedAt DateTime?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// 5.2 — Student Platform
// ---------------------------------------------------------------------------

model StudentProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline               String?
  bio                    String?
  phone                  String?
  dateOfBirth            DateTime?
  gender                 String?
  githubUrl              String?
  linkedinUrl            String?
  portfolioUrl           String?
  leetcodeUrl            String?
  codeforcesUrl          String?
  resumeUrl              String?
  city                   String?
  state                  String?
  country                String?
  collegeName            String?
  department             String?
  currentSemester        Int?
  expectedGraduationYear Int?
  isProfileVisible       Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([collegeName])
  @@index([department])
  @@index([expectedGraduationYear])
}

model SkillProfile {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  category          String   @default("other")
  proficiencyLevel  String   @default("intermediate") // beginner | intermediate | advanced | expert
  yearsOfExperience Float?   @default(0)
  isPrimary         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([category])
}

model CareerGoal {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  targetRole         String?
  targetCompanies    String[]
  industries         String[]
  preferredLocations String[]
  targetCtcLakhs     Int?
  targetDate         DateTime?
  status             String    @default("active") // active | achieved | archived
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  careerRoadmapItems CareerRoadmapItem[]

  @@index([userId])
  @@index([status])
  @@index([targetRole])
}

model ReadinessScore {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  overall      Int
  components   Json
  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([overall])
  @@index([calculatedAt])
}

model ReadinessPrediction {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readinessScore Int
  predictedLevel String // low | medium | high
  monthsToReady  Int
  components     Json
  predictedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([predictedLevel])
  @@index([predictedAt])
}

model RoadmapWeek {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber Int
  title      String
  focus      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tasks DailyTask[]

  @@unique([userId, weekNumber])
  @@index([userId])
}

model DailyTask {
  id            String      @id @default(cuid())
  roadmapWeekId String
  roadmapWeek   RoadmapWeek @relation(fields: [roadmapWeekId], references: [id], onDelete: Cascade)
  day           Int
  title         String
  description   String
  taskType      String // dsa | aptitude | company | project | resume | mock
  reference     String? // generic reference, no FK to DSA Problem yet
  isCompleted   Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([roadmapWeekId])
}

model CompanyPrepTrack {
  id          String   @id @default(cuid())
  company     String   @unique
  description String
  focusAreas  String[]
  resources   Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([company])
}

model ProgressRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalTasks Int
  completed  Int
  percent    Int
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([recordedAt])
}

model DailyChallenge {
  id          String   @id @default(cuid())
  date        DateTime @unique
  title       String
  description String
  taskType    String // dsa | aptitude | company | project | mock
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model StudyPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  plan      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @default("system") // system | announcement | academic | placement | job | mentor | general
  title     String
  message   String
  metadata  Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  eventType   String    @default("personal") // interview | study | exam | placement | personal | other
  startAt     DateTime
  endAt       DateTime?
  location    String?
  isAllDay    Boolean   @default(false)
  color       String?
  reminderAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, startAt])
  @@index([eventType])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // profile | skill | career_goal | calendar | readiness | notification | system
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([type])
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  weeklyDigest       Boolean  @default(true)
  language           String   @default("en")
  theme              String   @default("light") // light | dark | system
  profileVisibility  String   @default("public") // public | recruiters_only | private
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// 5.3 — College Academic Module
// ---------------------------------------------------------------------------

model Department {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  description String?
  subjects    Subject[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

model Semester {
  id        String    @id @default(cuid())
  number    Int       @unique
  name      String
  scheme    String? // e.g. "2019" old scheme, "2023" new scheme — credit weight origin
  subjects  Subject[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([number])
}

model Subject {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  description       String?
  credit            Int                @default(4)
  departmentId      String
  department        Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semesterId        String
  semester          Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  facultyId         String?
  faculty           User?              @relation("SubjectFaculty", fields: [facultyId], references: [id], onDelete: SetNull)
  materials         StudyMaterial[]
  exams             Exam[]
  assignments       Assignment[]
  attendanceRecords AttendanceRecord[]
  timetableSlots    TimetableSlot[]
  internalMarks     InternalMark[]
  questionBank      QuestionBankItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([departmentId])
  @@index([semesterId])
  @@index([facultyId])
  @@index([credit])
}

model StudyMaterial {
  id         String   @id @default(cuid())
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title      String
  type       String   @default("note") // note | slide | video | link | reference
  url        String
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([subjectId])
}

model Exam {
  id          String         @id @default(cuid())
  subjectId   String
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  examType    String         @default("internal") // internal | midterm | endterm | practical
  maxMarks    Float          @default(100)
  scheduledAt DateTime?
  marks       InternalMark[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([subjectId])
}

model Assignment {
  id          String                 @id @default(cuid())
  subjectId   String
  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  maxScore    Float?
  dueAt       DateTime?
  submissions AssignmentSubmission[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([subjectId])
}

model AssignmentSubmission {
  id            String     @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  content       String?
  attachmentUrl String?
  submittedAt   DateTime   @default(now())
  status        String     @default("submitted") // submitted | graded
  score         Float?
  feedback      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  sessionDate DateTime
  status      String   @default("present") // present | absent | late | excused
  markedBy    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([subjectId, studentId, sessionDate])
  @@index([studentId])
  @@index([subjectId])
}

model TimetableSlot {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Mon .. 6=Sun
  startTime String
  endTime   String
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([dayOfWeek])
}

model InternalMark {
  id            String   @id @default(cuid())
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examId        String?
  exam          Exam?    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       User     @relation("StudentInternalMarks", fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained Float
  maxMarks      Float
  attempt       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([subjectId, studentId, examId])
  @@index([studentId])
  @@index([subjectId])
}

model AcademicCalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  eventType   String    @default("academic") // academic | exam | holiday | event | deadline
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startAt])
  @@index([eventType])
}

model QuestionBankItem {
  id            String   @id @default(cuid())
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  question      String
  options       Json?
  correctAnswer String?
  difficulty    String   @default("medium") // easy | medium | hard
  marks         Float?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([subjectId])
  @@index([difficulty])
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// DSA Platform (5.5 / 5.20)
// ---------------------------------------------------------------------------

model Problem {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  statement     String   @db.Text
  difficulty    String // easy | medium | hard
  topics        String[]
  companies     String[]
  tags          String[]
  timeLimitMs   Int      @default(1000)
  memoryLimitMb Int      @default(256)
  isPremium     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  testCases         TestCase[]
  editorial         Editorial?
  hints             Hint[]
  submissions       Submission[]
  hintUnlocks       HintUnlock[]
  solvedBy          SolvedProblem[]
  playlistEntries   PlaylistProblem[]
  sheetEntries      SheetProblem[]
  discussions       Discussion[]
  contestEntries    ContestProblem[]
  interviewSessions InterviewSession[]
  battles           Battle[]

  @@index([difficulty])
  @@index([isActive])
  @@index([topics(ops: ArrayOps)], type: Gin)
  @@index([companies(ops: ArrayOps)], type: Gin)
  @@index([tags(ops: ArrayOps)], type: Gin)
}

model TestCase {
  id             String   @id @default(cuid())
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String   @db.Text
  expectedOutput String   @db.Text
  isSample       Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([problemId])
  @@index([problemId, isSample])
}

model Editorial {
  id         String   @id @default(cuid())
  problemId  String   @unique
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  complexity String? // e.g. "O(n) time, O(1) space"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Hint {
  id        String   @id @default(cuid())
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  order     Int
  content   String
  createdAt DateTime @default(now())

  @@index([problemId])
  @@index([problemId, order])
}

model Submission {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId         String
  problem           Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contestId         String?
  contest           Contest?  @relation(fields: [contestId], references: [id])
  battleId          String?
  battle            Battle?   @relation(fields: [battleId], references: [id])
  languageId        Int
  sourceCode        String    @db.Text
  status            String    @default("queued") // queued | running | completed | failed
  verdict           String? // accepted | wrong_answer | time_limit_exceeded | memory_limit_exceeded | runtime_error | compilation_error
  passedTestCases   Int       @default(0)
  totalTestCases    Int       @default(0)
  failedCaseIndex   Int?
  failedCaseVerdict String?
  errorMessage      String?
  stdout            String?   @db.Text
  stderr            String?   @db.Text
  timeMs            Float?
  memoryKb          Int?
  submittedAt       DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([problemId])
  @@index([userId, problemId])
  @@index([contestId])
  @@index([battleId])
  @@index([status])
  @@index([verdict])
  @@index([submittedAt])
}

model SolvedProblem {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId     String
  problem       Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  firstSolvedAt DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
}

model HintUnlock {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId     String
  problem       Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  unlockedHints Int      @default(1) // highest hint order revealed for this user+problem
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
}

// ---------------------------------------------------------------------------
// DSA Platform — organize & track (5.5b)
// ---------------------------------------------------------------------------

model Playlist {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isPublic    Boolean           @default(false) // shared lists are public; private lists 404 for others
  problems    PlaylistProblem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([isPublic])
}

model PlaylistProblem {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  problemId  String
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([playlistId, problemId])
  @@index([problemId])
}

model Sheet {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String?
  isActive    Boolean        @default(true)
  problems    SheetProblem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([isActive])
}

model SheetProblem {
  id        String   @id @default(cuid())
  sheetId   String
  sheet     Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([sheetId, problemId])
  @@index([problemId])
}

model Discussion {
  id          String           @id @default(cuid())
  problemId   String
  problem     Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  authorId    String
  author      User             @relation("DiscussionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  body        String           @db.Text
  upvoteCount Int              @default(0)
  votes       DiscussionVote[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([problemId])
  @@index([authorId])
  @@index([createdAt])
}

model DiscussionVote {
  id           String     @id @default(cuid())
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([discussionId, userId])
  @@index([userId])
}

model DsaProfileVisibility {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  showFullName    Boolean  @default(true)
  showEmail       Boolean  @default(false)
  showCollege     Boolean  @default(true)
  showSkills      Boolean  @default(true)
  showSolvedCount Boolean  @default(true)
  showTopics      Boolean  @default(true)
  showStreak      Boolean  @default(true)
  showRating      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// DSA Platform — compete (5.5c)

model Contest {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  title                String
  description          String?              @db.Text
  startTime            DateTime
  endTime              DateTime
  status               String               @default("draft") // draft | published | ongoing | finished | cancelled
  isRated              Boolean              @default(false)
  rules                String?              @db.Text
  createdBy            String
  problems             ContestProblem[]
  participants         ContestParticipant[]
  standingsFinalizedAt DateTime?
  submissions          Submission[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User?                @relation(fields: [userId], references: [id])
  userId               String?

  @@index([status])
  @@index([startTime, endTime])
}

model ContestProblem {
  id            String         @id @default(cuid())
  contestId     String
  contest       Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problemId     String
  problem       Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  order         Int            @default(0)
  basePoints    Int            @default(100)
  createdAt     DateTime       @default(now())
  contestSolves ContestSolve[]

  @@unique([contestId, problemId])
  @@index([problemId])
}

model ContestParticipant {
  id             String         @id @default(cuid())
  contestId      String
  contest        Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation("ContestParticipants", fields: [userId], references: [id], onDelete: Cascade)
  score          Float          @default(0)
  penaltySeconds Int            @default(0)
  rank           Int?
  ratingBefore   Int?
  ratingAfter    Int?
  ratingDelta    Int?
  solvedProblems ContestSolve[]
  registeredAt   DateTime       @default(now())

  @@unique([contestId, userId])
  @@index([userId])
  @@index([contestId, score])
}

model ContestSolve {
  id               String             @id @default(cuid())
  participantId    String
  participant      ContestParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  contestProblemId String
  contestProblem   ContestProblem     @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
  firstAcceptedAt  DateTime?
  attemptCount     Int                @default(0)
  maxPointsEarned  Float              @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([participantId, contestProblemId])
  @@index([contestProblemId])
}

model CodingRating {
  id                   String                @id @default(cuid())
  userId               String                @unique
  user                 User                  @relation("CodingRatingUser", fields: [userId], references: [id], onDelete: Cascade)
  rating               Int                   @default(1200)
  bestRating           Int                   @default(1200)
  contestsParticipated Int                   @default(0)
  history              CodingRatingHistory[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model CodingRatingHistory {
  id             String       @id @default(cuid())
  codingRatingId String
  codingRating   CodingRating @relation(fields: [codingRatingId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("CodingRatingHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  source         String       @default("contest") // contest | battle
  contestId      String?
  contestName    String?
  battleId       String?
  battle         Battle?      @relation(fields: [battleId], references: [id])
  rank           Int
  ratingBefore   Int
  ratingAfter    Int
  delta          Int
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([codingRatingId])
  @@index([battleId])
}

// ---------------------------------------------------------------------------
// 5.9 — Coding Battles

model Battle {
  id              String                @id @default(cuid())
  type            String // ranked | practice | private
  status          String                @default("active") // pending | active | finished | cancelled
  problemId       String
  problem         Problem               @relation(fields: [problemId], references: [id], onDelete: Cascade)
  durationSeconds Int                   @default(900)
  startedAt       DateTime?
  endsAt          DateTime?
  finishedAt      DateTime?
  winnerId        String?
  winner          User?                 @relation("BattleWinner", fields: [winnerId], references: [id])
  ratingAppliedAt DateTime?
  inviteCode      String?               @unique
  createdById     String?
  createdBy       User?                 @relation("BattleCreator", fields: [createdById], references: [id])
  participants    BattleParticipant[]
  submissions     Submission[]
  ratingHistory   CodingRatingHistory[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status])
  @@index([type])
  @@index([endsAt])
  @@index([inviteCode])
  @@index([createdById])
}

model BattleParticipant {
  id             String    @id @default(cuid())
  battleId       String
  battle         Battle    @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation("BattleParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  score          Int       @default(0)
  penaltySeconds Int       @default(0)
  rank           Int?
  ratingBefore   Int?
  ratingAfter    Int?
  ratingDelta    Int?
  solvedAt       DateTime?
  joinedAt       DateTime  @default(now())

  @@unique([battleId, userId])
  @@index([userId])
  @@index([battleId, score])
}

model AntiCheatEvent {
  id         String   @id @default(cuid())
  sourceType String // dsa-contest | coding-battle | practical-exam
  sourceId   String
  userId     String
  user       User     @relation("AntiCheatUser", fields: [userId], references: [id], onDelete: Cascade)
  eventType  String // tab-switch | copy-paste | focus-out | suspicious-submission
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// 5.6 — AI Interview Engine
// ---------------------------------------------------------------------------

model InterviewSession {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // hr | technical | dsa | system-design
  mode      String              @default("text") // text now; voice/video explicitly not available
  status    String              @default("created") // created | in_progress | ended
  problemId String? // linked real DSA catalog problem for type=dsa
  problem   Problem?            @relation(fields: [problemId], references: [id])
  startedAt DateTime?
  endedAt   DateTime?
  turns     InterviewTurn[]
  feedback  InterviewFeedback[]
  report    InterviewReport?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([type])
}

model InterviewTurn {
  id              String              @id @default(cuid())
  sessionId       String
  session         InterviewSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role            String // ai | user
  content         String              @db.Text
  code            String?             @db.Text
  languageId      Int?
  judgeVerdict    String?
  passedTestCases Int?
  totalTestCases  Int?
  timeMs          Float?
  memoryKb        Int?
  order           Int                 @default(0)
  feedback        InterviewFeedback[]
  createdAt       DateTime            @default(now())

  @@index([sessionId, order])
}

model InterviewFeedback {
  id        String           @id @default(cuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turnId    String?
  turn      InterviewTurn?   @relation(fields: [turnId], references: [id], onDelete: Cascade)
  skill     String
  score     Int // 1-10
  comment   String           @db.Text
  createdAt DateTime         @default(now())

  @@index([sessionId])
  @@index([turnId])
}

model InterviewReport {
  id           String           @id @default(cuid())
  sessionId    String           @unique
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallScore Int
  summary      String           @db.Text
  strengths    String[]
  improvements String[]
  suggestions  String[]
  topicScores  Json?
  generatedAt  DateTime         @default(now())

  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// 5.7 — AI Career Coach
// ---------------------------------------------------------------------------

model CareerRoadmapItem {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerGoalId String?
  careerGoal   CareerGoal? @relation(fields: [careerGoalId], references: [id], onDelete: SetNull)
  phase        Int // 1-based ordering of the long-horizon trajectory
  title        String
  duration     String // e.g. "0-3 months"
  summary      String
  focus        String[]
  milestones   String[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, phase])
  @@index([userId])
  @@index([careerGoalId])
}

model LearningRecommendation {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill        String
  title        String
  resourceType String // course | article | practice | book
  provider     String?
  url          String?
  priority     Int      @default(1)
  reason       String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([skill])
}

model SalaryPrediction {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole     String
  targetCompany  String?
  currency       String   @default("INR")
  baseLakhs      Float
  totalCtcLakhs  Float
  rangeLowLakhs  Float
  rangeHighLakhs Float
  confidence     Int // 0-100
  isEstimate     Boolean  @default(true)
  factors        Json?
  generatedAt    DateTime @default(now())

  @@index([userId])
}

model SkillGap {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole String
  missing    String[]
  present    String[]
  coverage   Float // 0..1 — present / target
  assessedAt DateTime @default(now())

  @@index([userId])
  @@index([targetRole])
}

model CareerChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// 5.8 — Resume Builder & ATS
// ---------------------------------------------------------------------------

model ResumeTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  isActive    Boolean  @default(true)
  style       Json // declarative layout: fonts, colors, spacing
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resumes Resume[]

  @@index([isActive])
}

model Resume {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  templateId String
  template   ResumeTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  content    Json // structured resume content (contact, sections, etc.)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  versions ResumeVersion[]
  analyses AtsAnalysis[]

  @@index([userId])
  @@index([templateId])
  @@index([updatedAt])
}

model ResumeVersion {
  id         String   @id @default(cuid())
  resumeId   String
  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  version    Int // 1-based, monotonically increasing per resume
  title      String
  templateId String
  content    Json
  createdAt  DateTime @default(now())

  @@unique([resumeId, version])
  @@index([resumeId])
}

model AtsAnalysis {
  id                String   @id @default(cuid())
  resumeId          String   @unique
  resume            Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  score             Int // 0-100 deterministic
  sectionScores     Json // per-section present/missing + points
  missingSections   String[]
  atsIssues         Json // detected ATS-hostile elements
  textDensity       String? // sparse | good | dense
  keywordOverlap    Json? // when a job description was supplied
  suggestions       Json?
  suggestionsStatus String   @default("none") // none | ready | failed
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([resumeId])
}
