generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 5.1 — Auth & Identity
// ---------------------------------------------------------------------------

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  passwordHash           String
  fullName               String
  avatarUrl              String?
  roleId                 String
  role                   Role                    @relation(fields: [roleId], references: [id])
  isActive               Boolean                 @default(true)
  emailVerifiedAt        DateTime?
  suspendedAt            DateTime?
  suspendReason          String?
  deletedAt              DateTime?
  twoFactor              TwoFactorSecret?
  sessions               Session[]
  devices                Device[]
  oauthAccounts          OAuthAccount[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  auditLogs              AuditLog[]
  studentProfile         StudentProfile?
  skillProfiles          SkillProfile[]
  careerGoals            CareerGoal[]
  readinessScore         ReadinessScore?
  notifications          Notification[]
  calendarEvents         CalendarEvent[]
  activityLogs           ActivityLog[]
  settings               UserSettings?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdAt])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  users       User[]
  permissions Permission[] @relation("RolePermissions")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  roles       Role[]   @relation("RolePermissions")
  createdAt   DateTime @default(now())

  @@index([name])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  deviceId         String?
  device           Device?   @relation(fields: [deviceId], references: [id])
  ip               String?
  userAgent        String?
  issuedAt         DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([revokedAt])
  @@index([expiresAt])
}

model Device {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String?
  platform  String?
  browser   String?
  os        String?
  pushToken String?
  lastUsedAt DateTime @default(now())
  sessions  Session[]
  createdAt DateTime  @default(now())

  @@index([userId])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  providerEmail     String?
  profileJson       Json?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([providerEmail])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TwoFactorSecret {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret     String
  isEnabled  Boolean   @default(false)
  verifiedAt DateTime?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// 5.2 — Student Platform
// ---------------------------------------------------------------------------

model StudentProfile {
  id                     String        @id @default(cuid())
  userId                 String        @unique
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline               String?
  bio                    String?
  phone                  String?
  dateOfBirth            DateTime?
  gender                 String?
  githubUrl              String?
  linkedinUrl            String?
  portfolioUrl           String?
  leetcodeUrl            String?
  codeforcesUrl          String?
  resumeUrl              String?
  city                   String?
  state                  String?
  country                String?
  collegeName            String?
  department             String?
  currentSemester        Int?
  expectedGraduationYear Int?
  isProfileVisible       Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([collegeName])
  @@index([department])
  @@index([expectedGraduationYear])
}

model SkillProfile {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  category         String   @default("other")
  proficiencyLevel String   @default("intermediate") // beginner | intermediate | advanced | expert
  yearsOfExperience Float?  @default(0)
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@unique([userId, name])
}

model CareerGoal {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  targetRole       String?
  targetCompanies  String[]
  industries       String[]
  preferredLocations String[]
  targetCtcLakhs   Int?
  targetDate       DateTime?
  status           String   @default("active") // active | achieved | archived
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([targetRole])
}

model ReadinessScore {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  overall          Int
  components       Json
  calculatedAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([overall])
  @@index([calculatedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @default("system") // system | announcement | academic | placement | job | mentor | general
  title     String
  message   String
  metadata  Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  eventType   String    @default("personal") // interview | study | exam | placement | personal | other
  startAt     DateTime
  endAt       DateTime?
  location    String?
  isAllDay    Boolean   @default(false)
  color       String?
  reminderAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, startAt])
  @@index([eventType])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // profile | skill | career_goal | calendar | readiness | notification | system
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([type])
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  weeklyDigest       Boolean  @default(true)
  language           String   @default("en")
  theme              String   @default("light") // light | dark | system
  profileVisibility  String   @default("public") // public | recruiters_only | private
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
