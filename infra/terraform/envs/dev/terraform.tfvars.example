region     = "us-east-1"
environment = "dev"

vpc_cidr             = "10.0.0.0/16"
azs                  = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24", "10.0.12.0/24"]
single_nat_gateway   = true

db_instance_class     = "db.t3.medium"
db_name               = "xkill"
db_username           = "xkill_admin"
# db_password = "your-password-here"

redis_node_type            = "cache.t3.micro"
redis_cluster_mode_enabled = false

api_image          = "123456789012.dkr.ecr.us-east-1.amazonaws.com/xkill-api:latest"
api_cpu            = 256
api_memory         = 512
api_desired_count  = 1

judge_image          = "123456789012.dkr.ecr.us-east-1.amazonaws.com/xkill-judge:latest"
judge_cpu            = 1024
judge_memory         = 2048
judge_desired_count  = 0

# domain_name = "xkill.io"
# github_org  = "your-org"
# github_repo = "xkill"
