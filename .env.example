# ---- App ----
NODE_ENV=development
PORT=3000

# ---- Database (Prisma) ----
# Used by docker-compose postgres service
DATABASE_URL=postgresql://xkill:xkill@localhost:5432/xkill?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=xkill-backend
JWT_AUDIENCE=xkill-app

# ---- Identity defaults ----
DEFAULT_ROLE=student
# Where the frontend lives; used for mail links + OAuth success redirects
APP_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# ---- 2FA ----
TWO_FACTOR_ISSUER=XKILL

# ---- OAuth ----
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
OAUTH_LINKEDIN_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/linkedin/callback

# ---- Mail (SES/SMTP behind MailService; console transport in dev) ----
MAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@xkill.app

# ---- Judge0 (only used by health check; set to enable) ----
JUDGE0_BASE_URL=
JUDGE0_AUTH_TOKEN=

# ---- Rate limiting ----
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
AUTH_RATE_LIMIT_LIMIT=10

# ---- Admin bootstrap ----
# Seed admin user created by prisma/seed.ts
ADMIN_EMAIL=admin@xkill.app
ADMIN_PASSWORD=Admin@1234
